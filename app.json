{
  "expo": {
    "scheme": "infradesk",
    "name": "InfraDesk",
    "slug": "infradesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "O InfraDesk usa a câmera para você fotografar o problema que quer relatar.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O InfraDesk acessa suas fotos para você anexar imagens do problema.",
          "cameraPermission": "O InfraDesk usa a câmera para você fotografar o problema que quer relatar.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
